{
    "name": "crabphp/crab-cf-worker",
    "description": "A Crab application running inside a Cloudflare Worker, on PHP compiled to WebAssembly",
    "type": "project",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "^0.7.3",
        "symfony/polyfill-mbstring": "^1.31"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "platform-check": false,
        "optimize-autoloader": true
    },
    "prefer-stable": true
}
